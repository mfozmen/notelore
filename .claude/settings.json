{
  "env": {
    "NOTELORE_HOME": ".dev-home"
  },
  "permissions": {
    "allow": [
      "Bash(flutter pub get:*)",
      "Bash(flutter test:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart test:*)",
      "Bash(dart run coverage:*)",
      "Bash(dart run tool/coverage_gate.dart:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
