{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "references": {
    "commentie": {
      "repository": "mfozmen/commentie",
      "description": "commentie's canonical comment rule, cleanup steps, critic agent and check script; tool/check_comments.py is a byte-identical copy"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "~/.claude/plugins/cache/devkit/**": "allow"
    },
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
