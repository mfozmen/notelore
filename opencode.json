{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "plugin": [["commentie@0.2.1", { "hook": true }]],
  "references": {
    "commentie": {
      "repository": "mfozmen/commentie",
      "description": "commentie's canonical comment rule, cleanup steps, critic agent and check script; tool/check_comments.py is a byte-identical copy of 0.2.1"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
